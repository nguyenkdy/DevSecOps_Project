// trigger rebuild
pipeline {
  agent any

  environment {
    SERVICE_NAME          = 'product-service'
    SERVICE_DIR           = 'services/product-service'
    AWS_ACCOUNT_ID        = credentials('aws-account-id')
    AWS_REGION            = 'ap-southeast-1'
    ECR_REGISTRY          = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    IMAGE_TAG             = "${BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'latest'}"
  }

  options {
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Detect Changes') {
      steps {
        script {
          def commitMsg = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
          if (commitMsg.contains('[skip ci]')) {
            echo "Jenkins manifest commit — bỏ qua pipeline"
            env.SKIP = 'true'
            return
          }
          def changed = sh(
            script: "git diff --name-only HEAD~1 HEAD | grep '^${env.SERVICE_DIR}/' | grep -v '/Jenkinsfile\$' || true",
            returnStdout: true
          ).trim()
          if (!changed) {
            echo "Không có thay đổi trong ${env.SERVICE_DIR} — bỏ qua pipeline"
            env.SKIP = 'true'
          }
        }
      }
    }

    stage('Install') {
      when { not { environment name: 'SKIP', value: 'true' } }
      steps {
        dir(env.SERVICE_DIR) {
          sh 'npm ci --legacy-peer-deps --prefer-offline --no-audit'
        }
      }
    }

    stage('Lint & Build') {
      when { not { environment name: 'SKIP', value: 'true' } }
      parallel {
        stage('ESLint') {
          steps {
            dir(env.SERVICE_DIR) { sh 'npm run lint' }
          }
        }
        stage('Build') {
          steps {
            dir(env.SERVICE_DIR) { sh 'npm run build' }
          }
        }
      }
    }

    stage('Unit Test') {
      when { not { environment name: 'SKIP', value: 'true' } }
      steps {
        dir(env.SERVICE_DIR) {
          sh 'npm run test:cov -- --ci --forceExit'
        }
      }
    }

    stage('SonarQube') {
      when { not { environment name: 'SKIP', value: 'true' } }
      steps {
        dir(env.SERVICE_DIR) {
          withSonarQubeEnv('SonarQube') {
            sh '''
              npx sonar-scanner \
                -Dsonar.projectKey=product-service \
                -Dsonar.sources=src \
                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                -Dsonar.exclusions=**/*.spec.ts,**/*.module.ts
            '''
          }
        }
      }
    }

    stage('Security Scan - Trivy') {
      when { not { environment name: 'SKIP', value: 'true' } }
      steps {
        sh '''
          docker build -t ${SERVICE_NAME}:scan --target production ${SERVICE_DIR}
          trivy image --severity HIGH,CRITICAL --exit-code 0 --format table ${SERVICE_NAME}:scan
          docker rmi ${SERVICE_NAME}:scan || true
        '''
      }
    }

    stage('Build & Push ECR — Dev') {
      when {
        allOf {
          expression { env.GIT_BRANCH ==~ /.*\/develop|^develop$/ }
          not { environment name: 'SKIP', value: 'true' }
        }
      }
      steps {
        withCredentials([[
          $class: 'AmazonWebServicesCredentialsBinding',
          credentialsId: 'aws-credentials',
          accessKeyVariable: 'AWS_ACCESS_KEY_ID',
          secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
        ]]) {
          sh '''
            DEV_TAG="develop-${IMAGE_TAG}"
            aws ecr get-login-password --region ${AWS_REGION} | \
              docker login --username AWS --password-stdin ${ECR_REGISTRY}

            docker build -t ${ECR_REGISTRY}/${SERVICE_NAME}:${DEV_TAG} \
              --target production ${SERVICE_DIR}
            docker tag ${ECR_REGISTRY}/${SERVICE_NAME}:${DEV_TAG} \
              ${ECR_REGISTRY}/${SERVICE_NAME}:latest-develop

            docker push ${ECR_REGISTRY}/${SERVICE_NAME}:${DEV_TAG}
            docker push ${ECR_REGISTRY}/${SERVICE_NAME}:latest-develop
          '''
        }
      }
    }

    stage('Update GitOps Manifest — Dev') {
      when {
        allOf {
          expression { env.GIT_BRANCH ==~ /.*\/develop|^develop$/ }
          not { environment name: 'SKIP', value: 'true' }
        }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
          sh '''
            DEV_TAG="develop-${IMAGE_TAG}"
            sed -i "s|tag:.*|tag: ${DEV_TAG}|" infra/k8s/product-service/values.dev.yaml
            git config user.email "ci@jenkins"
            git config user.name "Jenkins CI"
            git remote set-url origin https://${GITHUB_TOKEN}@github.com/nguyenkdy/DevSecOps_Project.git
            git commit -am "ci: update product-service develop to ${DEV_TAG} [skip ci]" || echo "no changes"
            git fetch origin develop
            git rebase origin/develop
            git push origin HEAD:develop
          '''
        }
      }
    }

    stage('Build & Push ECR') {
      when {
        allOf {
          expression { env.GIT_BRANCH ==~ /.*\/main|^main$/ }
          not { environment name: 'SKIP', value: 'true' }
        }
      }
      steps {
        withCredentials([[
          $class: 'AmazonWebServicesCredentialsBinding',
          credentialsId: 'aws-credentials',
          accessKeyVariable: 'AWS_ACCESS_KEY_ID',
          secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
        ]]) {
          sh '''
            aws ecr get-login-password --region ${AWS_REGION} | \
              docker login --username AWS --password-stdin ${ECR_REGISTRY}

            docker build -t ${ECR_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG} \
              --target production ${SERVICE_DIR}
            docker tag ${ECR_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG} \
              ${ECR_REGISTRY}/${SERVICE_NAME}:latest

            docker push ${ECR_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG}
            docker push ${ECR_REGISTRY}/${SERVICE_NAME}:latest
          '''
        }
      }
    }

    stage('Update GitOps Manifest') {
      when {
        allOf {
          expression { env.GIT_BRANCH ==~ /.*\/main|^main$/ }
          not { environment name: 'SKIP', value: 'true' }
        }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
          sh '''
            sed -i "s|tag:.*|tag: ${IMAGE_TAG}|" infra/k8s/product-service/values.yaml
            git config user.email "ci@jenkins"
            git config user.name "Jenkins CI"
            git remote set-url origin https://${GITHUB_TOKEN}@github.com/nguyenkdy/DevSecOps_Project.git
            git commit -am "ci: update product-service to ${IMAGE_TAG} [skip ci]" || echo "no changes"
            git fetch origin main
            git rebase origin/main
            git push origin HEAD:main
          '''
        }
      }
    }
  }

  post {
    always {
      script {
        if (env.SKIP == 'true') {
          currentBuild.result = 'NOT_BUILT'
          echo "Pipeline skipped — no changes in ${env.SERVICE_DIR}"
        }
      }
      sh 'docker image prune -f || true'
    }
    success { echo "Pipeline thành công: ${SERVICE_NAME}:${IMAGE_TAG}" }
    failure { echo "Pipeline thất bại — kiểm tra log" }
  }
}

// trigger dev build

// rebuild after disk cleanup
